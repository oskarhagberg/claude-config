# ~/.claude — synced between machines via the claude-config repo.
#
# The rule: commit CONFIGURATION (settings, skills, scripts), never STATE
# (sessions, caches, logs, history) and never CREDENTIALS. State that is
# committed conflicts on every pull between two laptops; credentials must not
# reach a remote at all.

# ── credentials ─────────────────────────────────────────────────────────────
settings.local.json
# daemon/control.key is a credential
daemon/
daemon-auth-*

# ── per-machine config (each laptop writes its own) ─────────────────────────
cmux/config.local.sh

# ── Humly-only: this machine is a Humly machine, the other is not ───────────
# Nothing org-specific is tracked here. The Humly/vinga auto-mode environment
# and tracey permissions live in the repo they describe instead:
#   /Users/oskar/humly/vinga/.claude/settings.local.json (gitignored there)
# and the tracey skills are project skills in that repo
#   (.claude/skills/tracey-annotate, tracey-requirement).

# ── owned by Claude Usage.app — NEVER track these ───────────────────────────
# The app generates and rewrites all four. Committing them means a git
# checkout silently overwrites what the app just wrote, which breaks the app.
# fetch-claude-usage.swift additionally embeds an sk-ant-sid session token.
statusline-command.sh
statusline-config.txt
fetch-claude-usage.swift
.statusline-usage-cache

# ── big state: conversations, plugins, snapshots ────────────────────────────
projects/
history.jsonl
plugins/
file-history/
context-mode/

# ── caches ──────────────────────────────────────────────────────────────────
cache/
paste-cache/
statsig/
local/
stats-cache.json
gh-pr-status-cache.json
mcp-needs-auth-cache.json

# ── ephemeral per-session state ─────────────────────────────────────────────
shell-snapshots/
session-env/
sessions/
plans/
tasks/
todos/
jobs/
bridge-spawn/
ide/
.cc-writes/

# ── logs, debug, telemetry ──────────────────────────────────────────────────
logs/
daemon.log
debug/
telemetry/
feedback/

# ── runtime markers ─────────────────────────────────────────────────────────
.last-cleanup
.last-update-result.json
policy-limits.json
remote-settings.json

# ── local backups and scratch ───────────────────────────────────────────────
backups/
downloads/
*.bak
*.bak-*
settings.json.pre-*
